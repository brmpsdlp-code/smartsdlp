# PostgreSQL / Supabase
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="https://your-domain.example"
NEXT_PUBLIC_BETTER_AUTH_URL="https://your-domain.example"

# SMTP / Nodemailer
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="SMART BRMP SDLP <noreply@example.com>"

# First admin bootstrap (required only when running prisma/bootstrap-admin.ts)
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-one-time-password"

# Google Drive service account
GOOGLE_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="replace-with-google-drive-folder-id"

# Optional runtime
NODE_ENV="production"
